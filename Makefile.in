#
# Makefile for the Loki registry library
# $Id: Makefile.in,v 1.21 2008-07-25 22:57:14 megastep Exp $
#

CC	:= @CC@
AR	:= @AR@
CSRC	:= setupdb.c md5.c arch.c @GETOPT_C@
OS      := $(shell uname -s)
ARCH    := @ARCH@
OBJS    := $(CSRC:%.c=$(ARCH)/%.o)

SETUPDB_VERSION_MAJOR=@SETUPDB_VERSION_MAJOR@
SETUPDB_VERSION_MINOR=@SETUPDB_VERSION_MINOR@
DISTDIR = ..
VERSION = @SETUPDB_VERSION_MAJOR@.@SETUPDB_VERSION_MINOR@.@SETUPDB_VERSION_RELEASE@
PACKAGE = setupdb-$(VERSION)

CFLAGS	= @CPPFLAGS@ @CFLAGS@
CFLAGS	+= -DSETUPDB_VERSION_MAJOR=$(SETUPDB_VERSION_MAJOR)
CFLAGS  += -DSETUPDB_VERSION_MINOR=$(SETUPDB_VERSION_MINOR)
LIBS	= @LIBS@

IMAGE	= @IMAGE@

TARGET = $(ARCH)/libsetupdb.a

.PHONY: all check clean mostlyclean distclean dist
all: $(ARCH)/xml-major

check: setupdb md5sum
	sh -n uninstaller.sh
	@unset SETUP_ARCH; ./setupdb probe sysinfo | grep -F "Arch='$(ARCH)'"
	@set -e; input=$$(mktemp); trap 'rm -f "$$input"' 0; \
	printf abc > "$$input"; \
	test "$$(./md5sum "$$input")" = "900150983cd24fb0d6963f7d28e17f72  $$input"

$(ARCH):
	mkdir $(ARCH)

$(ARCH)/%.o: %.c config.h Makefile | $(ARCH)
	$(CC) $(CFLAGS) @DEPFLAGS@ -c $< -o $@

$(TARGET): $(OBJS) Makefile | $(ARCH)
	rm -f $@
	$(AR) rcs $@ $(OBJS)

$(ARCH)/xml-major: $(TARGET) Makefile
	printf '%s\n' '@SETUPDB_XML_MAJOR@' > $@.tmp
	mv $@.tmp $@

uninstaller.inc: uninstaller.sh Makefile
	sed -e 's/[\\"]/\\&/g' -e 's/^/"/' -e 's/$$/\\n"/' $< > $@.tmp
	mv $@.tmp $@

$(ARCH)/setupdb.o: uninstaller.inc

convert: $(ARCH)/convert.o $(TARGET)
	$(CC) @LDFLAGS@ -g -o $@ $(ARCH)/convert.o $(TARGET) $(LIBS) @STATIC@
	strip $@
	@BRANDELF@ -t $(OS) $@

install-convert: convert
	cp convert $(IMAGE)/bin/$(OS)/$(ARCH)/

brandelf: $(ARCH)/brandelf.o
	$(CC) @LDFLAGS@ -o $@ $(ARCH)/brandelf.o

md5sum: md5.c md5.h Makefile config.h
	$(CC) @LDFLAGS@ $(CFLAGS) -o $@ md5.c -DMD5SUM_PROGRAM -lz @STATIC@
	strip $@
	@BRANDELF@ -t $(OS) $@

setupdb: register.c $(TARGET)
	$(CC) @LDFLAGS@ $(CFLAGS) -o $@ register.c $(TARGET) $(LIBS) @STATIC@

install-register: setupdb
	strip setupdb
	@BRANDELF@ -t $(OS) setupdb
	cp setupdb $(IMAGE)/bin/$(OS)/$(ARCH)/

clean:
	rm -f $(ARCH)/*.o $(ARCH)/*.d $(TARGET) $(ARCH)/xml-major $(ARCH)/xml-major.tmp uninstaller.inc uninstaller.inc.tmp *~

mostlyclean: clean
	rm -f convert md5sum brandelf setupdb
	rm -f Makefile .depend config.h config.cache config.status config.log

distclean: mostlyclean
	-test ! -d $(ARCH) || rmdir $(ARCH)

DISTFILES = $(wildcard *.c *.h) configure.ac configure config.h.in config.guess \
            config.sub uninstaller.sh autogen.sh Makefile Makefile.in CHANGES COPYING README.md .github .gitignore

dist:
	@set -e; work=$$(mktemp -d); trap 'rm -rf "$$work"' 0; \
	mkdir "$$work/$(PACKAGE)"; \
	cp -R $(DISTFILES) "$$work/$(PACKAGE)/"; \
	$(MAKE) -C "$$work/$(PACKAGE)" distclean; \
	tar -C "$$work" -czf "$$work/release.tar.gz" "$(PACKAGE)"; \
	mv "$$work/release.tar.gz" "$(DISTDIR)/$(PACKAGE).tar.gz"

.PHONY: dep depend
dep depend: all

-include $(wildcard $(ARCH)/*.d)
